_: {
  perSystem =
    {
      config,
      pkgs,
      lib,
      ...
    }:
    let
      # Autogenerated OpenAPI specifications for HWaaS components.
      #
      # Leverages the fact that every crate exposing an OpenAPI specification does so with a
      # dedicated binary with a fixed name. The name can easily be autogenerated from the crates
      # name.
      #
      # Unfortunately the derivations for the Rust crates do not currently expose an attribute that
      # would allow us to filter them automatically here. We could fall back to reading in their
      # `Cargo.toml`, but doesn't feel justified here.
      oas-packages =
        lib.concatMapAttrs
          (name: value: {
            ${name + "-oas"} = pkgs.runCommand ("generate-" + name + "-openapi-json") { } ''
              generator="${lib.getExe' value (name + "-openapi-generator")}"

              if [[ "${name}" =~ ^remote- ]]; then
                "$generator" > "$out"
              else
                # Stupid `hunt` overrides the `RUST_LOG` filter directive and **ALWAYS LOGS AN INFO
                # MESSAGE ON STDOUT DURING STARTUP**. Hence we cannot use the same invocation for
                # all components.
                "$generator" --out-file "$out"
              fi
            '';
          })
          {
            inherit (config.packages)
              remote-serial
              remote-power
              remote-usb
              remote-auxiliary
              contextapi
              net-ctrl
              ;
          };
    in
    {
      packages = rec {
        net-ctrl-client = pkgs.callPackage ./net-ctrl-client.nix {
          net-ctrl-openapi = oas-packages.net-ctrl-oas;
        };
        contextapi-version = pkgs.callPackage ./contextapi-version.nix {
          inherit (config.packages) contextapi;
        };
        hwaas-oas = pkgs.callPackage ./hwaas-oas.nix {
          inherit (config.packages) contextapi;
          extra-oas = lib.pipe oas-packages [
            (lib.filterAttrs (n: _v: (builtins.match "^remote-.*" n) != null))
            builtins.attrValues
          ];
        };
        http-sim = pkgs.callPackage ./http-sim/package.nix { };
        vue-client = pkgs.callPackage ./vue-client.nix { vueSrc = ../../vue-client; };
        documentation = pkgs.callPackage ./documentation.nix {
          documentationSrc = ../../documentation;
          inherit hwaas-oas;
        };
      }
      // oas-packages
      // import ./user-tooling.nix { inherit pkgs; };
    };
}
